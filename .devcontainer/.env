# ODK Central test stack pins (issue #170).
#
# docker compose -f .devcontainer/docker-compose.yml reads this file when it
# is the project directory (devcontainer) or via --env-file (CI / CLI).
# Every value here also has a fallback in docker-compose.yml, so the stack
# still boots if this file is missing.

# ODK Central backend image. Track upstream releases at
# https://github.com/getodk/central/tags
ODKC_VERSION=v2026.3.0

# pyxform-http image tag (as pinned in getodk/central/docker-compose.yml).
ODKC_VERSION_PYXFORM=v4.5.0

# Host port for the ODK Central API. ruODK tests use
#   ODKC_TEST_URL=https://localhost:<ODKC_PORT>
# and must trust the self-signed CA through the MERGED bundle that
#   .devcontainer/odkc/ca-bundle.sh
# builds. Do NOT point CURL_CA_BUNDLE at certs/ca.crt on its own: that
# setting REPLACES libcurl's CA bundle and breaks every other https call
# from R (CRAN, GitHub). See the header of odkc/ca-bundle.sh.
ODKC_PORT=8383

# sysadminAccount; also used as EMAIL_FROM. No mail is actually delivered:
# the service runs with nodemailer's json transport (see NODE_CONFIG in
# docker-compose.yml).
ODKC_SYSADMIN_EMAIL=no-reply@getodk.org
